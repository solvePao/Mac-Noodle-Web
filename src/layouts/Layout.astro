---
interface Props {
  title?: string;
}
const { title = 'Mac Noodle for macOS' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Mac Noodle — a free, open-source Mac cleaner. Remove junk, speed up your Mac, and reclaim storage. Notarized by Apple." />
    <meta property="og:title" content="Mac Noodle — A Mac cleaner that just works" />
    <meta property="og:description" content="Free up space, remove junk, and keep your Mac fast. Every build is signed, notarized, and checksum-verified. 100% free & open source." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mac Noodle" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <footer>
      <div class="footer-inner">
        <div class="footer-brand-col">
          <span class="footer-brand">
            <img src="/favicon.svg" alt="" width="22" height="22" style="vertical-align: -3px; margin-right: 6px;" />
            Mac Noodle
          </span>
          <p class="footer-tagline">A cleaner Mac, without the guesswork.</p>
        </div>
        <div class="footer-links-col">
          <span class="footer-heading">Links</span>
          <a href="#features">Features</a>
          <a href="#how-it-works">Install</a>
          <a href="#releases">Releases</a>
          <a href="https://github.com/solvePao/Mac-Noodle-App">GitHub</a>
        </div>
        <div class="footer-info-col">
          <span class="footer-heading">System</span>
          <p>macOS 12+ (Monterey)</p>
          <p>Built by Xcode Cloud</p>
          <p>© {year} solvePao</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ── Design tokens ───────────────────────────────────────────── */
  :root {
    --noodle-accent: #6366f1;
    --noodle-accent-light: #818cf8;
    --noodle-bg-dark: #0f172a;
    --noodle-bg-subtle: #f8fafc;
    --noodle-text: #111827;
    --noodle-text-muted: #64748b;
    --noodle-border: #e5e7eb;
    --noodle-radius: 16px;

    color-scheme: light;
    font-family: 'Inter', ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--noodle-text);
    background: #fff;
    scroll-behavior: smooth;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: #fff; }
  a { color: inherit; }

  /* ── Shared accent classes ──────────────────────────────────── */
  .text-accent { color: var(--noodle-accent); }
  .text-accent-light { color: var(--noodle-accent-light); }

  /* ── Layout containers ──────────────────────────────────────── */
  .site-header,
  footer .footer-inner {
    width: min(1180px, calc(100% - 40px));
    margin: auto;
  }
  main { width: min(1100px, calc(100% - 40px)); margin: auto; }

  /* ── Site header ────────────────────────────────────────────── */
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    border-bottom: 1px solid var(--noodle-border);
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 100;
    padding: 0;
  }
  .brand {
    font-size: 18px;
    font-weight: 720;
    text-decoration: none;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .brand-icon {
    border-radius: 6px;
  }
  nav { display: flex; gap: 26px; font-size: 14px; }
  nav a { color: var(--noodle-text-muted); text-decoration: none; transition: color 0.15s; }
  nav a:hover { color: var(--noodle-text); }
  .header-cta {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding: 0 18px;
    border-radius: 10px;
    background: var(--noodle-accent);
    color: #fff;
    font-size: 14px;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .header-cta:hover { background: var(--noodle-accent-light); }
  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: var(--noodle-text);
  }

  /* ── Shared typography ──────────────────────────────────────── */
  .eyebrow {
    margin: 0 0 16px;
    color: var(--noodle-text-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 820px;
    margin: 0;
    font-size: clamp(52px, 8vw, 96px);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }
  h2 { margin: 0; font-size: clamp(30px, 4vw, 46px); letter-spacing: -0.045em; }

  /* ── Shared buttons ─────────────────────────────────────────── */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 10px;
    font-weight: 650;
    font-size: 15px;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }
  .button-primary {
    color: #fff;
    background: var(--noodle-accent);
  }
  .button-primary:hover { background: var(--noodle-accent-light); }
  .button-outline {
    color: var(--noodle-text);
    background: transparent;
    border: 1.5px solid var(--noodle-border);
  }
  .button-outline:hover { border-color: var(--noodle-accent); color: var(--noodle-accent); }
  .button-light {
    color: var(--noodle-bg-dark);
    background: #fff;
  }
  .button-light:hover { background: #f1f5f9; }
  .button-ghost {
    color: rgba(255,255,255,0.85);
    background: transparent;
    border: 1.5px solid rgba(255,255,255,0.25);
  }
  .button-ghost:hover { border-color: rgba(255,255,255,0.6); color: #fff; }

  /* ── Hero ───────────────────────────────────────────────────── */
  .hero {
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--noodle-border);
    background: linear-gradient(180deg, var(--noodle-bg-subtle) 0%, #fff 100%);
  }
  .hero-icon-wrap { margin-bottom: 28px; }
  .hero-icon {
    width: 80px;
    height: 80px;
    border-radius: 18px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.10);
  }
  .lede {
    max-width: 600px;
    margin: 28px 0 0;
    color: var(--noodle-text-muted);
    font-size: 19px;
    line-height: 1.65;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 34px;
  }
  .release-status {
    min-height: 22px;
    margin: 18px 0 0;
    color: #94a3b8;
    font-size: 13px;
  }
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
    font-size: 13px;
    color: var(--noodle-text-muted);
  }
  .trust-badges li {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* ── Stats bar ──────────────────────────────────────────────── */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--noodle-border);
    border-bottom: 1px solid var(--noodle-border);
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 32px 16px;
    background: #fff;
    text-align: center;
  }
  .stat-icon { line-height: 0; }
  .stat-value {
    font-size: 20px;
    font-weight: 750;
    letter-spacing: -0.03em;
    color: var(--noodle-text);
  }
  .stat-label {
    font-size: 13px;
    color: var(--noodle-text-muted);
  }

  /* ── Feature cards ──────────────────────────────────────────── */
  .features {
    padding: 80px 0;
    border-bottom: 1px solid var(--noodle-border);
  }
  .features-header {
    margin-bottom: 48px;
  }
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .feature-card {
    padding: 32px 28px;
    border: 1px solid var(--noodle-border);
    border-radius: var(--noodle-radius);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .feature-card:hover {
    border-color: var(--noodle-accent);
    box-shadow: 0 8px 24px rgba(99,102,241,0.08);
    transform: translateY(-2px);
  }
  .feature-icon { line-height: 0; }
  .feature-card h3 {
    margin: 16px 0 8px;
    font-size: 19px;
    letter-spacing: -0.03em;
  }
  .feature-card p { margin: 0; color: var(--noodle-text-muted); line-height: 1.65; font-size: 15px; }

  /* ── How it works ───────────────────────────────────────────── */
  .how-it-works {
    padding: 80px 0;
    border-bottom: 1px solid var(--noodle-border);
  }
  .how-header { margin-bottom: 48px; }
  .how-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 56px;
  }
  .how-step {
    text-align: center;
    padding: 32px 20px;
    border-radius: var(--noodle-radius);
    background: var(--noodle-bg-subtle);
    position: relative;
  }
  .step-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--noodle-accent);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
  }
  .step-icon { display: block; margin: 0 auto 14px; line-height: 0; }
  .how-step h3 {
    margin: 0 0 8px;
    font-size: 18px;
    letter-spacing: -0.02em;
  }
  .how-step p {
    margin: 0;
    color: var(--noodle-text-muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .how-command {
    max-width: 720px;
  }
  .how-command-label {
    margin: 0 0 12px;
    font-weight: 600;
    font-size: 15px;
    color: var(--noodle-text-muted);
  }
  .code-row {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 12px 12px 12px 18px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: var(--noodle-bg-subtle);
  }
  .code-row code {
    overflow-x: auto;
    flex: 1;
    padding: 4px 0;
    color: #334155;
    font-size: 13px;
    white-space: nowrap;
  }
  .code-row button {
    flex-shrink: 0;
    border: 1px solid #dbe2ea;
    border-radius: 8px;
    padding: 9px 14px;
    color: var(--noodle-text);
    background: #fff;
    cursor: pointer;
    font-size: 13px;
    font-weight: 650;
    transition: background 0.15s, border-color 0.15s;
  }
  .code-row button:hover { background: #f1f5f9; border-color: #cbd5e1; }
  .command-details {
    margin: 16px 0 0;
    padding-left: 18px;
    color: var(--noodle-text-muted);
    line-height: 1.8;
    font-size: 14px;
  }
  .command-details code {
    font-size: 12px;
    background: #f1f5f9;
    padding: 1px 5px;
    border-radius: 4px;
    color: #334155;
  }

  /* ── Testimonials ───────────────────────────────────────────── */
  .testimonials {
    padding: 80px 0;
    border-bottom: 1px solid var(--noodle-border);
    background: var(--noodle-bg-subtle);
  }
  .testimonials-header { margin-bottom: 48px; }
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .testimonial-card {
    padding: 28px;
    border: 1px solid var(--noodle-border);
    border-radius: var(--noodle-radius);
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .testimonial-title {
    margin: 0;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
  }
  .testimonial-quote {
    margin: 0;
    color: var(--noodle-text-muted);
    font-size: 15px;
    line-height: 1.65;
    flex: 1;
  }
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .author-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--noodle-text);
  }

  /* ── Releases section ───────────────────────────────────────── */
  .releases { padding: 80px 0 110px; }
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 34px;
  }
  .section-heading > a {
    flex-shrink: 0;
    color: var(--noodle-text-muted);
    font-size: 14px;
    text-underline-offset: 4px;
  }
  .section-heading > a:hover { color: var(--noodle-text); }
  .total-downloads { margin: 6px 0 0; font-size: 13px; color: #94a3b8; }
  .release-list { border-top: 1px solid var(--noodle-text); }
  .release {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--noodle-border);
  }
  .release h3 { margin: 0 0 6px; font-size: 17px; letter-spacing: -0.02em; }
  .release p { margin: 0; color: var(--noodle-text-muted); font-size: 14px; }
  .release-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .release-links { display: flex; gap: 10px; }
  .release-links a {
    padding: 9px 13px;
    border: 1px solid #dbe2ea;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
  }
  .release-links a:hover { background: var(--noodle-bg-subtle); border-color: #cbd5e1; }
  .empty { padding: 28px 0; color: var(--noodle-text-muted); }
  .error-state { padding: 24px 0; }
  .retry-btn {
    margin: 12px 0;
    padding: 9px 18px;
    border: 1px solid #dbe2ea;
    border-radius: 8px;
    background: #fff;
    font-size: 14px;
    font-weight: 650;
    cursor: pointer;
    display: block;
    transition: background 0.15s;
  }
  .retry-btn:hover { background: var(--noodle-bg-subtle); }

  /* ── FAQ section ────────────────────────────────────────────── */
  .faq {
    padding: 80px 0;
    border-bottom: 1px solid var(--noodle-border);
  }
  .faq-header { margin-bottom: 40px; }
  .faq-list {
    max-width: 760px;
  }
  .faq-item {
    border-bottom: 1px solid var(--noodle-border);
  }
  .faq-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 20px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: var(--noodle-text);
  }
  .faq-question {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .faq-chevron {
    flex-shrink: 0;
    transition: transform 0.25s;
    color: var(--noodle-text-muted);
  }
  .faq-open .faq-chevron { transform: rotate(180deg); }
  .faq-answer {
    padding: 0 0 20px;
  }
  .faq-answer p {
    margin: 0;
    color: var(--noodle-text-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  /* ── Bottom CTA ─────────────────────────────────────────────── */
  .bottom-cta {
    background: var(--noodle-bg-dark);
    color: #fff;
    padding: 80px 20px;
    text-align: center;
  }
  .bottom-cta-inner {
    max-width: 640px;
    margin: auto;
  }
  .bottom-cta h2 {
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: -0.05em;
  }
  .bottom-cta-text {
    margin: 16px 0 0;
    color: rgba(255,255,255,0.65);
    font-size: 18px;
    line-height: 1.6;
  }
  .bottom-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  /* ── Footer ─────────────────────────────────────────────────── */
  footer {
    border-top: 1px solid var(--noodle-border);
    padding: 48px 0;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
  }
  .footer-brand {
    font-weight: 720;
    font-size: 16px;
    color: var(--noodle-text);
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
  }
  .footer-tagline {
    margin: 8px 0 0;
    color: var(--noodle-text-muted);
    font-size: 14px;
  }
  .footer-heading {
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--noodle-text-muted);
    margin-bottom: 12px;
  }
  .footer-links-col { display: flex; flex-direction: column; gap: 8px; }
  .footer-links-col a {
    color: var(--noodle-text-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-links-col a:hover { color: var(--noodle-text); }
  .footer-info-col { display: flex; flex-direction: column; gap: 4px; }
  .footer-info-col p {
    margin: 0;
    color: var(--noodle-text-muted);
    font-size: 13px;
  }

  /* ── Skeleton loader ────────────────────────────────────────── */
  @keyframes shimmer {
    from { background-position: -600px 0; }
    to   { background-position:  600px 0; }
  }
  .skeleton {
    height: 16px;
    border-radius: 6px;
    background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
    background-size: 600px 100%;
    animation: shimmer 1.4s ease-in-out infinite;
  }
  .release--skeleton { pointer-events: none; }

  /* ── Responsive ─────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .features-grid { grid-template-columns: 1fr 1fr; }
    .testimonials-grid { grid-template-columns: 1fr 1fr; }
    .how-steps { grid-template-columns: 1fr 1fr; }
    /* hide the third step's connector on 2-col */
    .how-steps .how-step:nth-child(3) { grid-column: 1 / -1; max-width: 400px; margin: 0 auto; }
  }

  @media (max-width: 760px) {
    /* Header mobile */
    .site-header { min-height: 60px; flex-wrap: wrap; }
    .menu-toggle { display: block; }
    .header-cta { display: none; }
    nav {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding: 8px 0 16px;
      border-top: 1px solid var(--noodle-border);
    }
    nav.nav-visible { display: flex; }
    nav a { padding: 10px 0; }

    /* Hero */
    .hero { padding: 64px 0 60px; }
    .hero-icon { width: 64px; height: 64px; }

    /* Stats */
    .stats-bar { grid-template-columns: 1fr 1fr; }

    /* Features */
    .features-grid { grid-template-columns: 1fr; gap: 14px; }
    .features { padding: 52px 0; }

    /* How it works */
    .how-steps { grid-template-columns: 1fr; gap: 16px; }
    .how-steps .how-step:nth-child(3) { max-width: none; }
    .how-it-works { padding: 60px 0; }

    /* Testimonials */
    .testimonials-grid { grid-template-columns: 1fr; }
    .testimonials { padding: 60px 0; }

    /* Releases */
    .release { grid-template-columns: 1fr; gap: 12px; }
    .release-links { flex-wrap: wrap; }

    /* FAQ */
    .faq { padding: 60px 0; }

    /* Bottom CTA */
    .bottom-cta { padding: 60px 20px; }
    .bottom-cta-actions { flex-direction: column; align-items: stretch; }

    /* Footer */
    .footer-inner { grid-template-columns: 1fr; gap: 24px; }
    footer { padding: 32px 0; }
  }

  @media (max-width: 480px) {
    h1 { font-size: clamp(40px, 12vw, 64px); }
    .lede { font-size: 16px; }
    .trust-badges { gap: 10px 18px; }
    .actions { flex-direction: column; align-items: stretch; }
    .actions .button { justify-content: center; }
  }
</style>
