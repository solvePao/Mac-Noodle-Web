---
interface Props {
  title?: string;
}

const { title = 'Mac Noodle for macOS' } = Astro.props;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Download Mac Noodle for macOS from GitHub Releases or use the checksum-verifying terminal helper." />
    <meta name="theme-color" content="#3c2f2f" />
    <meta property="og:title" content="Mac Noodle — Download for macOS" />
    <meta property="og:description" content="Download the latest ZIP from GitHub Releases or use the checksum-verifying terminal helper." />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mac Noodle" />
    <meta property="og:url" content="https://macnoodle.solvepao.com/" />
    <link rel="canonical" href="https://macnoodle.solvepao.com/" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />
    <footer>
      <div class="footer-inner">
        <div class="footer-brand-col">
          <span class="footer-brand">
            <img src="/favicon.svg" alt="" width="24" height="24" />
            Mac Noodle
          </span>
          <p class="footer-tagline">Downloads, installation helper, and project links.</p>
        </div>
        <div class="footer-links-col">
          <span class="footer-heading">Links</span>
          <a href="#features">Options</a>
          <a href="#how-it-works">Install</a>
          <a href="https://github.com/solvePao/Mac-Noodle-Web/releases">Releases</a>
          <a href="https://github.com/solvePao/Mac-Noodle-Web">GitHub</a>
        </div>
        <div class="footer-info-col">
          <span class="footer-heading">System</span>
          <p>Static Astro website</p>
          <p>Hosted on Cloudflare Pages</p>
          <p>© {year} solvePao</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* Cappuccino palette from the Better University theme system. */
    --noodle-accent: #854442;
    --noodle-accent-light: #a9713b;
    --noodle-success: #5f7a54;
    --noodle-danger: #8e3b34;
    --noodle-ink: #3c2f2f;
    --noodle-text: #3c2f2f;
    --noodle-text-muted: #7a6257;
    --noodle-bg: #fff4e6;
    --noodle-surface: #fffaf5;
    --noodle-bg-dark: #3c2f2f;
    --noodle-bg-subtle: rgba(133, 68, 66, 0.11);
    --noodle-success-wash: rgba(95, 122, 84, 0.11);
    --noodle-border: rgba(75, 56, 50, 0.18);
    --noodle-shadow: 0 18px 48px rgba(75, 56, 50, 0.1);
    --noodle-radius: 22px;

    color-scheme: light;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
    color: var(--noodle-text);
    background: var(--noodle-bg);
    scroll-behavior: smooth;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --noodle-accent: #be9b7b;
      --noodle-accent-light: #d9a868;
      --noodle-success: #94b287;
      --noodle-danger: #c97b70;
      --noodle-ink: #fff4e6;
      --noodle-text: #fff4e6;
      --noodle-text-muted: #a68e7e;
      --noodle-bg: #241b19;
      --noodle-surface: #3c2f2f;
      --noodle-bg-dark: #1a1210;
      --noodle-bg-subtle: rgba(190, 155, 123, 0.14);
      --noodle-success-wash: rgba(148, 178, 135, 0.13);
      --noodle-border: rgba(190, 155, 123, 0.28);
      --noodle-shadow: 0 18px 48px rgba(0, 0, 0, 0.24);
      color-scheme: dark;
    }
  }

  * { box-sizing: border-box; }
  html { scroll-padding-top: 110px; }
  body {
    min-width: 320px;
    margin: 0;
    overflow-x: clip;
    background:
      radial-gradient(circle at 100% 0%, var(--noodle-bg-subtle), transparent 34rem),
      var(--noodle-bg);
    color: var(--noodle-text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  button, a { -webkit-tap-highlight-color: transparent; }
  :focus-visible { outline: 3px solid var(--noodle-accent); outline-offset: 3px; }

  .text-accent { color: var(--noodle-accent); }
  .text-accent-light { color: var(--noodle-accent-light); }

  main,
  .site-header,
  footer .footer-inner {
    width: min(1180px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    top: 12px;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 68px;
    margin-top: 12px;
    padding: 10px 12px 10px 18px;
    background: color-mix(in srgb, var(--noodle-surface) 84%, transparent);
    border: 1px solid var(--noodle-border);
    border-radius: 18px;
    box-shadow: 0 10px 34px color-mix(in srgb, var(--noodle-ink) 8%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    color: var(--noodle-text);
    font-size: 16px;
    font-weight: 760;
    letter-spacing: -0.025em;
    text-decoration: none;
  }
  .brand-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    box-shadow: 0 7px 18px var(--noodle-bg-subtle);
  }
  nav { display: flex; align-items: center; gap: 6px; }
  nav a {
    padding: 8px 11px;
    border-radius: 9px;
    color: var(--noodle-text-muted);
    font-size: 13px;
    font-weight: 650;
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }
  nav a:hover { color: var(--noodle-accent); background: var(--noodle-bg-subtle); }
  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 11px;
    background: var(--noodle-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 760;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.15s, opacity 0.15s;
  }
  .header-cta:hover { transform: translateY(-1px); opacity: 0.92; }
  .menu-toggle {
    display: none;
    padding: 7px;
    background: transparent;
    border: 0;
    border-radius: 9px;
    color: var(--noodle-text);
    cursor: pointer;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin: 0 0 24px;
    padding: 7px 12px;
    background: var(--noodle-bg-subtle);
    border: 1px solid color-mix(in srgb, var(--noodle-accent) 28%, transparent);
    border-radius: 999px;
    color: var(--noodle-accent);
    font-size: 11px;
    font-weight: 820;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow i {
    width: 7px;
    height: 7px;
    background: var(--noodle-success);
    border-radius: 50%;
    box-shadow: 0 0 0 5px var(--noodle-success-wash);
  }
  h1, h2, h3, p { text-wrap: pretty; }
  h1 {
    max-width: 680px;
    margin: 0;
    font-size: clamp(58px, 7.4vw, 96px);
    line-height: 0.93;
    letter-spacing: -0.068em;
  }
  h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -0.052em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 50px;
    padding: 10px 20px;
    border: 1px solid transparent;
    border-radius: 13px;
    font-size: 14px;
    font-weight: 760;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.18s, background 0.18s, border-color 0.18s;
  }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--noodle-accent); box-shadow: 0 14px 28px var(--noodle-bg-subtle); }
  .button-outline { color: var(--noodle-text); background: var(--noodle-surface); border-color: var(--noodle-border); }
  .button-outline:hover { border-color: var(--noodle-accent); }
  .button-light { color: #3c2f2f; background: #fff4e6; }
  .button-ghost { color: #fff4e6; background: transparent; border-color: rgba(255, 244, 230, 0.26); }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(420px, 0.98fr);
    align-items: center;
    gap: clamp(42px, 7vw, 92px);
    min-height: 720px;
    padding: 82px 0 74px;
  }
  .hero-copy { position: relative; z-index: 2; }
  .lede {
    max-width: 610px;
    margin: 28px 0 0;
    color: var(--noodle-text-muted);
    font-size: 17px;
    line-height: 1.75;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .trust-badges {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
    max-width: 580px;
    margin: 34px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--noodle-border);
    color: var(--noodle-text-muted);
    font-size: 12px;
    list-style: none;
  }
  .trust-badges li { display: flex; align-items: center; gap: 9px; }
  .trust-badges li > span {
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    background: var(--noodle-success);
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--noodle-success-wash);
  }

  .hero-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 590px;
    overflow: hidden;
    border-radius: 44px;
    isolation: isolate;
  }
  .hero-stage::before {
    position: absolute;
    inset: 5% 3%;
    z-index: -3;
    background:
      radial-gradient(circle at 25% 20%, var(--noodle-bg-subtle), transparent 38%),
      radial-gradient(circle at 72% 80%, var(--noodle-success-wash), transparent 40%),
      color-mix(in srgb, var(--noodle-surface) 84%, transparent);
    border: 1px solid var(--noodle-border);
    border-radius: 44px;
    box-shadow: var(--noodle-shadow);
    content: "";
    transform: rotate(2deg);
  }
  .stage-grid {
    position: absolute;
    inset: 10%;
    z-index: -2;
    opacity: 0.25;
    background-image:
      linear-gradient(var(--noodle-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--noodle-border) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: radial-gradient(circle, #000 25%, transparent 76%);
  }
  .stage-orbit { position: absolute; z-index: -1; border: 1px solid var(--noodle-border); border-radius: 50%; }
  .orbit-one { width: 430px; height: 430px; }
  .orbit-two { width: 520px; height: 520px; opacity: 0.55; }
  .cleaner-window {
    width: min(390px, 78%);
    overflow: hidden;
    background: var(--noodle-surface);
    border: 7px solid color-mix(in srgb, var(--noodle-ink) 90%, #000);
    border-radius: 30px;
    box-shadow: 0 38px 80px -24px color-mix(in srgb, var(--noodle-ink) 40%, transparent);
    transform: rotate(-3deg);
  }
  .window-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 13px 16px;
    background: color-mix(in srgb, var(--noodle-bg) 78%, var(--noodle-surface));
    border-bottom: 1px solid var(--noodle-border);
    font-size: 10px;
  }
  .window-bar strong { font-size: 11px; }
  .window-dots { display: flex; gap: 5px; }
  .window-dots i { width: 7px; height: 7px; background: var(--noodle-border); border-radius: 50%; }
  .window-dots i:first-child { background: var(--noodle-danger); }
  .window-dots i:nth-child(2) { background: var(--noodle-accent); }
  .window-dots i:last-child { background: var(--noodle-success); }
  .window-ready { justify-self: end; color: var(--noodle-success); font-size: 8px; font-weight: 850; letter-spacing: 0.12em; }
  .window-content { padding: 26px 24px 24px; }
  .window-kicker { color: var(--noodle-accent); font-size: 9px; font-weight: 850; letter-spacing: 0.14em; }
  .window-content h3 { margin: 5px 0 22px; font-size: 28px; line-height: 1.04; letter-spacing: -0.045em; }
  .scan-total {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    padding: 17px;
    background: var(--noodle-success-wash);
    border: 1px solid var(--noodle-border);
    border-radius: 16px;
  }
  .scan-total span { color: var(--noodle-text-muted); font-size: 10px; }
  .scan-total strong { color: var(--noodle-success); font-size: 23px; letter-spacing: -0.04em; }
  .clean-row {
    display: grid;
    grid-template-columns: 90px 1fr 48px;
    align-items: center;
    gap: 9px;
    margin-top: 12px;
    color: var(--noodle-text-muted);
    font-size: 9px;
  }
  .clean-row strong { color: var(--noodle-text); text-align: right; }
  .clean-bar { height: 7px; overflow: hidden; background: var(--noodle-border); border-radius: 999px; }
  .clean-bar i { display: block; height: 100%; background: var(--noodle-success); border-radius: inherit; }
  .clean-bar-warn i { background: var(--noodle-accent); }
  .scan-action {
    display: flex;
    justify-content: space-between;
    margin-top: 22px;
    padding: 12px 14px;
    background: var(--noodle-accent);
    border-radius: 11px;
    color: #fff;
    font-size: 11px;
    font-weight: 760;
  }
  .floating-card {
    position: absolute;
    z-index: 4;
    width: 174px;
    padding: 14px;
    background: color-mix(in srgb, var(--noodle-surface) 93%, transparent);
    border: 1px solid var(--noodle-border);
    border-radius: 14px;
    box-shadow: var(--noodle-shadow);
    backdrop-filter: blur(14px);
  }
  .floating-card span, .floating-card strong, .floating-card small { display: block; }
  .floating-card span { color: var(--noodle-accent); font-size: 8px; font-weight: 850; letter-spacing: 0.12em; }
  .floating-card strong { margin-top: 4px; font-size: 11px; }
  .floating-card small { margin-top: 2px; color: var(--noodle-text-muted); font-size: 9px; }
  .floating-safe { right: -4px; top: 21%; transform: rotate(4deg); }
  .floating-scan { left: -7px; bottom: 20%; transform: rotate(-5deg); }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    overflow: hidden;
    margin-bottom: 84px;
    background: var(--noodle-border);
    border: 1px solid var(--noodle-border);
    border-radius: 24px;
    box-shadow: var(--noodle-shadow);
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    min-height: 150px;
    padding: 28px 16px;
    background: var(--noodle-surface);
    text-align: center;
  }
  .stat-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 3px;
    background: var(--noodle-bg-subtle);
    border-radius: 13px;
    line-height: 0;
  }
  .stat-value { font-size: 19px; font-weight: 800; letter-spacing: -0.035em; }
  .stat-label { color: var(--noodle-text-muted); font-size: 12px; }

  .features {
    padding: 72px 64px;
    background: color-mix(in srgb, var(--noodle-surface) 78%, transparent);
    border: 1px solid var(--noodle-border);
    border-radius: 32px;
  }
  .features-header { max-width: 820px; margin-bottom: 46px; }
  .features-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
  .feature-card {
    grid-column: span 6;
    min-height: 250px;
    padding: 28px;
    background: var(--noodle-surface);
    border: 1px solid var(--noodle-border);
    border-radius: 24px;
    box-shadow: var(--noodle-shadow);
    transition: transform 0.18s, border-color 0.18s;
  }
  .feature-card:nth-child(1), .feature-card:nth-child(6) { grid-column: span 7; }
  .feature-card:nth-child(2), .feature-card:nth-child(5) { grid-column: span 5; }
  .feature-card:first-child { background: linear-gradient(135deg, var(--noodle-bg-subtle), var(--noodle-surface) 62%); }
  .feature-card:nth-child(4) { background: linear-gradient(135deg, var(--noodle-success-wash), var(--noodle-surface) 66%); }
  .feature-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--noodle-accent) 42%, var(--noodle-border)); }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: var(--noodle-bg-subtle);
    border-radius: 14px;
    line-height: 0;
  }
  .feature-card h3 { margin: 30px 0 8px; font-size: 20px; letter-spacing: -0.03em; }
  .feature-card p { max-width: 510px; margin: 0; color: var(--noodle-text-muted); font-size: 14px; line-height: 1.68; }

  .how-it-works { padding: 100px 0; }
  .how-header { max-width: 780px; margin-bottom: 44px; }
  .how-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 42px; }
  .how-step {
    padding: 26px 24px;
    background: var(--noodle-surface);
    border: 1px solid var(--noodle-border);
    border-radius: 20px;
  }
  .step-num {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 25px;
    background: var(--noodle-accent);
    border-radius: 12px;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }
  .step-icon { display: none; }
  .how-step h3 { margin: 0 0 8px; font-size: 17px; letter-spacing: -0.025em; }
  .how-step p { margin: 0; color: var(--noodle-text-muted); font-size: 13px; line-height: 1.65; }
  .how-command {
    max-width: 850px;
    padding: 28px;
    background: var(--noodle-bg-dark);
    border-radius: 22px;
    color: #fff4e6;
  }
  .how-command-label { margin: 0 0 12px; color: #be9b7b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; }
  .code-row { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 18px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 13px; }
  .code-row code { flex: 1; min-width: 0; overflow-x: auto; color: #fff4e6; font-size: 12px; white-space: nowrap; }
  .code-row button { flex-shrink: 0; padding: 9px 14px; background: var(--noodle-accent); border: 0; border-radius: 9px; color: #fff; font: inherit; font-size: 12px; font-weight: 760; cursor: pointer; }
  .command-details { margin: 16px 0 0; padding-left: 18px; color: #be9b7b; font-size: 12px; line-height: 1.85; }
  .command-details code { color: #fff4e6; }

  .faq { padding: 96px 0; }
  .faq-header { max-width: 760px; margin-bottom: 40px; }
  .faq-list { max-width: 800px; }
  .faq-item { margin-bottom: 12px; padding: 0 22px; background: var(--noodle-surface); border: 1px solid var(--noodle-border); border-radius: 16px; }
  .faq-btn { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; padding: 20px 0; background: transparent; border: 0; color: var(--noodle-text); text-align: left; font: inherit; cursor: pointer; }
  .faq-question { font-size: 15px; font-weight: 700; }
  .faq-chevron { flex-shrink: 0; color: var(--noodle-accent); transition: transform 0.22s; }
  .faq-open .faq-chevron { transform: rotate(180deg); }
  .faq-answer { padding: 0 0 20px; }
  .faq-answer p { margin: 0; color: var(--noodle-text-muted); font-size: 14px; line-height: 1.7; }

  .bottom-cta {
    margin-bottom: 96px;
    padding: 74px 30px;
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 10%, rgba(190,155,123,0.22), transparent 28rem),
      var(--noodle-bg-dark);
    border-radius: 30px;
    color: #fff4e6;
    text-align: center;
  }
  .bottom-cta-inner { max-width: 680px; margin: auto; }
  .bottom-cta h2 { font-size: clamp(42px, 6vw, 68px); }
  .bottom-cta-text { margin: 18px 0 0; color: #be9b7b; font-size: 16px; }
  .bottom-cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 32px; }

  footer { padding: 0 0 46px; }
  .footer-inner { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 40px; padding-top: 42px; border-top: 1px solid var(--noodle-border); }
  .footer-brand { display: flex; align-items: center; gap: 9px; font-size: 15px; font-weight: 760; }
  .footer-brand img { border-radius: 7px; }
  .footer-tagline { margin: 8px 0 0; color: var(--noodle-text-muted); font-size: 13px; }
  .footer-heading { display: block; margin-bottom: 12px; color: var(--noodle-text-muted); font-size: 10px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .footer-links-col, .footer-info-col { display: flex; flex-direction: column; gap: 7px; }
  .footer-links-col a { color: var(--noodle-text-muted); font-size: 13px; text-decoration: none; }
  .footer-links-col a:hover { color: var(--noodle-accent); }
